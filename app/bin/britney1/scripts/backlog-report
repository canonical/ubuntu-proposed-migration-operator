#! /usr/bin/python3
#
# Generate a report of the backlog in -proposed.

from __future__ import print_function

__metaclass__ = type

import calendar
import csv
import gzip
import io
from optparse import OptionParser
import os
import re
import sys
import time


generated_re = re.compile(r"^<p>Generated: (.*)</p>$")
age_re = re.compile(r"^<li>([0-9]+) days old$")


def import_excuses(csv_writer, path):
    generated_time = None
    valid_candidates = 0
    not_considered = 0
    ages = []
    backlog = 0

    if path.endswith(".gz"):
        binary = gzip.open(path)
    else:
        binary = io.open(path, mode="rb")
    try:
        with io.BufferedReader(binary) as buffered:
            with io.TextIOWrapper(buffered) as text:
                for line in text:
                    match = generated_re.match(line)
                    age_match = age_re.match(line)
                    if match:
                        generated_time = time.strptime(
                            match.group(1), "%Y.%m.%d %H:%M:%S +0000")
                    elif age_match:
                        ages.append(int(age_match.group(1)))
                        backlog += max(int(age_match.group(1)) - 3, 0)
                    elif 'Will attempt migration' in line:
                        valid_candidates += 1
                    elif 'BLOCKED' in line:
                        not_considered += 1
                    elif 'Waiting for test results,' in line:
                        not_considered += 1
    finally:
        binary.close()

    assert generated_time is not None

    csv_writer.writerow({
        "time": calendar.timegm(generated_time) * 1000,
        "valid candidates": valid_candidates,
        "not considered": not_considered,
        "total": valid_candidates + not_considered,
        "median age": ages[int(len(ages)/2)],
        "backlog": backlog,
        })


def main():
    parser = OptionParser(description="Generate a backlog report.")
    parser.add_option(
        "-o", "--output", help="Write output to this file (default: stdout).")
    options, args = parser.parse_args()

    if options.output is not None:
        csv_is_new = not os.path.exists(options.output)
        if sys.version < "3":
            output = open(options.output, "ab")
        else:
            output = open(options.output, "a", newline="")
    else:
        csv_is_new = True
        output = sys.stdout

    try:
        csv_writer = csv.DictWriter(
            output, ["time", "valid candidates", "not considered", "total",
                     "median age", "backlog"])
        if csv_is_new:
            csv_writer.writeheader()
        for arg in args:
            import_excuses(csv_writer, arg)
    finally:
        if options.output is not None:
            output.close()


if __name__ == "__main__":
    main()
