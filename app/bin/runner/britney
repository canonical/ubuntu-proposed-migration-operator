make_hints_git () {
  ! [ -d "$1" ] && mkdir "$1"
  ret=0
  (
    cd "$1" || exit 1
    if ! [ -d .git ]; then
        git init .
        git remote add origin "$2"
    else
        git config remote.origin.url "$2"
    fi
    git fetch origin -q
    if git branch -q -D "$3"; then
      git checkout --force --track -b "$3" "origin/$3"
    else
      git reset --hard "origin/$3"
    fi) || ret=$?
    if [ "$ret" != "0" ]; then
        echo "ERROR: make_hints_git failed -- directory=$1 url=$2" 1>&2
    fi
    return $ret
}

sanitise_hints_kernel () {
  if ! [ -d "$2" ]; then
    echo "No general hints directory, ignoring." >&2
    return
  fi
  if ! [ -e "$1" ]; then
    echo "No kernel-team hints file $1 found, ignoring." >&2
    return
  fi
  # Parse the existing hints files and accumulate release-team created blocks;
  # also detect block-all source.  Then run over the kernel-team/release hints
  # and reduce them to valid block/unblocks for approved packages which are not
  # also blocked by the release-team.  As part of this we "flatten" the
  # supplied blocks such that one appears per line which simplifies disabling
  # individual packages.
  awk -v hints="$1" '
    # Ensure we do not consume our own output when considering blocks.
    (FILENAME ~ "/kernel-testing") { nextfile; }
    /^[ 	]*block[ 	]/ {
      for (n=2; n<=NF; n++) {
        blocks[$n]=1
      }
    }
    /^[ 	]*block-all[ 	][ 	]*source/ {
      blocks["ALL"]=1
    }
    END {
      for (block in blocks) {
        print("# RT BLOCKS " block)
      }
      while (getline <hints > 0) {
        # Blocks must only be linux packages and unversioned.
        if (/^block[ 	]/) {
          for (n=2; n<=NF; n++) {
            if ($n ~ "/") {
              print("# IGNORED(bad-form): block " $n)
            } else if ($n == "linux" || $n ~ "^linux-") {
              print("block " $n)
            } else {
              print("# IGNORED(bad-package): block " $n)
            }
          }
        # Unblocks must only be linux packages, versioned, and not
        # in the manual blocks list.
        } else if (/^unblock[ 	]/) {
          for (n=2; n<=NF; n++) {
            split($n, bits, "/")
            if ("ALL" in blocks || bits[1] in blocks) {
              print("# IGNORED(manually-blocked): unblock " $n)
            } else if ($n ~ "^linux/" || $n ~ "^linux-[^/]*/") {
              print("unblock " $n)
            } else {
              print("# IGNORED(bad-package/form): unblock " $n)
            }
          }
        # Comments and blank lines are ok.
        } else if (/^#/ || /^$/) {
          print($0)
        # Anything else is invalid.
        } else {
          print("# IGNORED(invalid-directive): " $0)
        }
      }
    }
  ' "$2/"* >"$3.new"
  mv -f "$3.new" "$3"
}

if option hints_git; then
  echo HINTS_GIT:
  if [ "$DISTRIBUTION" = ubuntu ]; then
    # temporarily use https for this repo because the git:// protocol is blocked by firewall on PS7
    kernel_git_repo="https://git.launchpad.net/~ubuntu-kernel-release/britney/+git/hints-ubuntu"
    hints_git_repo="https://git.launchpad.net/~ubuntu-release/britney/+git/hints-ubuntu"
    if [ "$SERIES" = "$DEFAULT_SERIES" ]; then
      branch="devel"
    else
      branch="$SERIES"
    fi
    make_hints_git "$DATA_B2/$SERIES-proposed/Hints" "$hints_git_repo" "$branch"
    # Kernel team kernel-release hints.
    kernel_hint_dir="$DATA_B2/$SERIES-proposed/Hints/kernel-testing-hints"
    make_hints_git "$kernel_hint_dir" "$kernel_git_repo" "$branch"
    sanitise_hints_kernel "$kernel_hint_dir/release" "$DATA_B2/$SERIES-proposed/Hints" "$DATA_B2/$SERIES-proposed/Hints/kernel-testing"
  fi
fi

run_b1 () {
  cd $UPDATE_OUT
  ./update_out.py $TESTING $UNSTABLE $TPU
}

b2_diff () {
    tmp_dir=`mktemp -d`
    master="b2"
    [ "$master" = "b1" ] && secondary="b2" || secondary="b1"
    (cd $tmp_dir

    sort $TESTING/HeidiResult >HeidiResult_b1
    sort $B2_OUTPUT/$SERIES/HeidiResult >HeidiResult_b2

    sed -e '/^<p>Generated: /d' $CODE/update_out/update.EXCUSES_py >excuses_b1.html
    sed -e '/^<p>Generated: /d' $B2_OUTPUT/$SERIES/excuses.html >excuses_b2.html

    touch -m -r $TESTING/HeidiResult HeidiResult_b1
    touch -m -r $B2_OUTPUT/$SERIES/HeidiResult HeidiResult_b2

    touch -m -r $CODE/update_out/update.EXCUSES_py excuses_b1.html
    touch -m -r $B2_OUTPUT/$SERIES/excuses.html excuses_b2.html

    # NB: If you remove the "head" below, add a "|| true"; otherwise
    # set -e may not allow the HeidiResult diff to execute.
    diff -u excuses_${master}.html excuses_${secondary}.html | head -n 1000
    diff -u HeidiResult_${master} HeidiResult_${secondary} | head -n 1000)
    rm -rf $tmp_dir
}

b2_diff_with_mail () {
  b2_diff
  b2_diff | ifne mail -s "britney2 diff `date -u +'%Y-%m-%d %H:%M'`" \
    -a "Reply-To: britney2@release.debian.org" britney2@release.debian.org
}

make_b2_config () {
    local arches archindep
    arches=`suite_arches $SERIES`
    archindep=`suite_archindep $SERIES`
    adt_arches=$arches
    sed -e "s/^\\(ARCHITECTURES  *= \\).*/\\1$arches/" \
        -e "s/^\\(NOBREAKALL_ARCHES  *= \\).*/\\1$archindep/" \
        -e "/^ADT_AMQP/ s@:password@:${B2_AMQP_PASSWORD//@/\\@}@" \
        "$1" >"$2"

    # only do the email thing for the default series
    #
    # and
    #
    # only do SRU regression emails for the non default series
    if [ -n "$NO_ACT" ]; then
        # honor a global toggle to disable side-effects (no email, no
        # triggering tests, no archive updating)
        sed -i '/^EMAIL_ENABLE/ s/=.*$/= no/' "$2"
        sed -i '/^SRUREGRESSIONEMAIL_ENABLE/ s/=.*$/= no/' "$2"
        sed -i '/^ADT_ENABLE/ s/yes/dry-run/' "$2"
    elif [ "$SERIES" != "$DEFAULT_SERIES" ]; then
        sed -i '/^EMAIL_ENABLE/ s/=.*$/= no/' "$2"
        sed -i '/^SRUREGRESSIONEMAIL_ENABLE/ s/=.*$/= yes/' "$2"
    fi
    case $SERIES in
	focal)
          sed -i '/^NEW_ARCHES/ s/=.*$/= riscv64/' "$2"
          sed -i '/^BREAK_ARCHES/ s/=.*$/= riscv64/' "$2"
          ;;
	# vorlon 2023-07-03 workaround for linux-restricted-modules failures
	jammy)
          echo "CHECK_CONSISTENCY_LEVEL = 0" >> "$2"
          ;;
	noble)
          # remove riscv64 from adt_arches
          adt_arches=$(echo $adt_arches | sed -e's/ riscv64//')
	  ;;
	questing)
          # remove amd64v3 from adt_arches
          adt_arches=$(echo $adt_arches | sed -e's/ amd64v3//')
	  ;;
    esac

    sed -i -e"/^ADT_ARCHES/ s/=.*$/= $adt_arches/" "$2"
}

make_b2_notest_config () {
    sed -e '/^NONINST_STATUS/ s/ *$/-notest/' \
        -e '/^EXCUSES_.*OUTPUT/ s%=.*$%= /dev/null%' \
        -e '/^UPGRADE_OUTPUT/ s/output.txt/output_notest.txt/' \
        -e '/^HEIDI_OUTPUT/ s/=.*$/=/' \
        -e '/^ADT_ENABLE/ s/yes/no/' \
        -e '/^EMAIL_ENABLE/ s/=.*$/= no/' \
        "$1" > "$2"
}

run_b2 () {
  cd $BASE
  make_b2_config "$B2_CONFIG" "$B2_CONFIG.$DISTRIBUTION.$SERIES"
  $CODE_B2/britney.py -c "$B2_CONFIG.$DISTRIBUTION.$SERIES" -v --distribution=$DISTRIBUTION --series=$SERIES

}

run_notest () {
  # for the devel series we also want an output.txt without tests, to make
  # it easier to untangle library transitions
  make_b2_notest_config "$B2_CONFIG.$DISTRIBUTION.$SERIES" "$B2_CONFIG.$DISTRIBUTION.$SERIES.notest"
  $CODE_B2/britney.py -c "$B2_CONFIG.$DISTRIBUTION.$SERIES.notest" --distribution=$DISTRIBUTION --series=$SERIES >/dev/null
  cp $DATA_B2/output/$SERIES/output_notest.txt $HTML/$SERIES/update_output_notest.txt
}

