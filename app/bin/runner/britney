lp_import() {
  # tell LP about the new delta
  promote-to-release -l "$LP_SERVICE" -d "$DISTRIBUTION" -s "$SERIES" -v "$1"
}

save () {
  cd $BASE
  echo RESULTS:
  # process a delta
  if [ "$1" = "b1" ]; then
    DELTA="$TESTING/HeidiResultDelta"
  else
    DELTA="$B2_OUTPUT/$SERIES/HeidiResultDelta"
  fi
  echo Using data from $DELTA
  lp_import "$DELTA"
  printf " done\n"
}

